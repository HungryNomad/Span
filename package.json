{
  "name": "span",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply span --remote && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply span --local",
    "db:migrate:remote": "wrangler d1 migrations apply span --remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
