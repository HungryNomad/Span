{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "span",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	// Serve only on the custom domain, so Cloudflare Access can't be bypassed
	// through a public *.workers.dev or preview URL.
	"workers_dev": false,
	"preview_urls": false,
	// Static UI from public/; unknown paths fall back to index.html (SPA).
	// /api/* always reaches the Worker first.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// TODO: replace with your subdomain (the zone must be on this Cloudflare account).
	"routes": [
		{
			"pattern": "span.hungrynomad.io",
			"custom_domain": true
		}
	],
	// TODO: paste the id printed by `wrangler d1 create span`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "span",
			"database_id": "a2c1c6ca-60d4-479f-a969-9cbe2e8ba3e8",
			"migrations_dir": "migrations"
		}
	],
	// Item pictures (resized in the browser, served only through /api/images).
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "span-images"
		}
	],
	// Worker Previews (non-main branch builds). Previews don't inherit the
	// production bindings above, and this block deliberately adds none, so a
	// preview can never read or write the live plans or pictures. Plan and
	// picture routes answer 503 there until preview-only resources are bound.
	"previews": {}
}
