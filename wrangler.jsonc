{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "span",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Serve only on the custom domain, so Cloudflare Access can't be bypassed
  // through a public *.workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,

  // Static UI from public/; unknown paths fall back to index.html (SPA).
  // /api/* always reaches the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // TODO: replace with your subdomain (the zone must be on this Cloudflare account).
  "routes": [{ "pattern": "plan.example.com", "custom_domain": true }],

  // TODO: paste the id printed by `wrangler d1 create span`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "span",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
